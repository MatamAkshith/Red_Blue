# Target Machine / Backend Configuration
# For local testing:
TARGET_HOST=127.0.0.1
TARGET_PORT=8000
TARGET_ENDPOINT=/events/run-demo

# For remote Render target deployment:
# TARGET_HOST=redblue-backend.onrender.com
# TARGET_PORT=443
# TARGET_SCHEME=https
# Or full target URL:
# TARGET_URL=https://redblue-backend.onrender.com/events/run-demo

# Request Timeout (seconds)
TARGET_TIMEOUT=10.0

