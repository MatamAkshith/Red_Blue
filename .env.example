# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Featherless (OpenAI-compatible API) -- https://api.featherless.ai/v1
FEATHERLESS_API_KEY=your-featherless-api-key-here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=NousResearch/Meta-Llama-3.1-8B-Instruct

# SQLite path for the event store
BLACKBOX_DB_PATH=blackbox.db
